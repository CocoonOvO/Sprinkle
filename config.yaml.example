app:
  name: "Sprinkle"
  host: "0.0.0.0"
  port: 8003
  debug: true

database:
  driver: "postgresql"
  host: "localhost"
  port: 5432
  name: "sprinkle_db"
  user: "CHANGE_ME"
  password: "CHANGE_ME"

redis:
  host: "localhost"
  port: 6379
  db: 0

kernel:
  auth:
    secret_key: "CHANGE_ME"

logging:
  level: "INFO"
  file: "logs/sprinkle.log"
  max_bytes: 10485760
  backup_count: 5

# OpenClaw Gateway Configuration
openclaw:
  enabled: true
  gateway_url: "ws://127.0.0.1:18789"
  api_token: null  # Set to your OpenClaw Gateway token if required
  default_agent_id: "scone"
  timeout: 30.0
  max_retries: 3
